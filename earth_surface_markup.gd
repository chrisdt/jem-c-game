static func floor_contains(region: int, point: Vector2) -> bool:
	var art := point/WORLD_SIZE*ART_SIZE
	if not Geometry2D.is_point_in_polygon(art,FLOORS[region]): return false
	# The marked bridge and jetty are solid ground above the water.
	for deck in DECKS.get(region,[]):
		if Geometry2D.is_point_in_polygon(art,deck): return true
	for wall in WALLS[region]:
		if Geometry2D.is_point_in_polygon(art,wall): return false
	for island in ISLANDS[region]:
		if ((art-Vector2(island.x,island.y))/Vector2(island.z,island.w)).length_squared() < 1: return false
	return true
