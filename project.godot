config_version=5
[application]
config/name="Sunny Scout — Planet Adventures"
config/icon="res://assets/copper_ore.png"
run/main_scene="res://startup.tscn"
boot_splash/image="res://assets/ui/title_landscape.png"
boot_splash/bg_color=Color(0.025, 0.075, 0.09, 1)
boot_splash/fullsize=true
boot_splash/use_filter=true
[autoload]
RunSession="*res://ui/run_session.gd"
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
[gameplay]
rocket_repair_required=false
[editor_plugins]
enabled=PackedStringArray("res://addons/earth_streaming/plugin.cfg")
[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
