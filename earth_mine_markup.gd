# Traced from the three red = walkable annotations, in original background
# pixels. Navigation only: never render the markup over the game artwork.
const ART_SIZE := Vector2(1499,1049)

# A deposit must leave a usable route around its footprint. Otherwise a rock
# placed across a newly narrowed corridor can strand the companion behind it.
static func ore_clear(point: Vector2, walkable: Callable) -> bool:
	for ray in 16:
		if not walkable.call(point+Vector2.from_angle(TAU*ray/16)*85): return false
	return true

