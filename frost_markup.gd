static func floor_contains(region: int, cave: bool, world_point: Vector2) -> bool:
	var point := world_point/SIZE*ART_SIZE
	var floors: Array = MINES[region] if cave else SURFACES[region]
	var inside := false
	for floor_region in floors:
		if Geometry2D.is_point_in_polygon(point,floor_region):
			inside = true
			break
	if not inside: return false
	for wall in HOLES.get(str(region)+("m" if cave else "s"),[]):
		if Geometry2D.is_point_in_polygon(point,wall): return false
	return true
