@tool
extends EditorExportPlugin

const FOLDERS := ["earth","frost","ember"]
const STARTUP_ART = preload("res://ui/startup_art.gd")
var web := false
var output := ""
var html_path := ""

func _get_name() -> String:
	return "PlanetSceneryStreaming"

func _export_begin(features: PackedStringArray, _debug: bool, path: String, _flags: int) -> void:
	web = features.has("web")
	output = path.get_base_dir()
	html_path = path

func _export_file(path: String, _type: String, features: PackedStringArray) -> void:
	if not features.has("web"): return
	for folder in FOLDERS:
		if path.begins_with("res://assets/"+folder+"/"):
			skip()
			return

func _export_end() -> void:
	if not web: return
	export_startup_art()
	for folder in FOLDERS:
		var target := output.path_join(folder+"_chunks")
		var destination := ProjectSettings.globalize_path(target if target.is_absolute_path() else "res://"+target)
		DirAccess.make_dir_recursive_absolute(destination)
		for file in DirAccess.get_files_at("res://assets/"+folder):
			if file.get_extension() != "png": continue
			# Keep opaque scenery out of the initial pack. Native uses lossless
			# imports; Web streams smaller, faster-decoding high-quality JPEGs.
			var painting := Image.new()
			var error := painting.load_png_from_buffer(FileAccess.get_file_as_bytes("res://assets/"+folder+"/"+file))
			if error == OK:
				error = painting.save_jpg(destination.path_join(file.get_basename()+".jpg"),0.92)
			if error != OK: push_error("Unable to export streamed scenery: "+folder+"/"+file)

func export_startup_art() -> void:
	var destination := ProjectSettings.globalize_path(output if output.is_absolute_path() else "res://"+output)
	var html_file := ProjectSettings.globalize_path(html_path if html_path.is_absolute_path() else "res://"+html_path)
	var backdrop := Image.new()
	var logo := Image.new()
	if backdrop.load_png_from_buffer(FileAccess.get_file_as_bytes(STARTUP_ART.BACKDROP_PATH)) != OK or logo.load_png_from_buffer(FileAccess.get_file_as_bytes(STARTUP_ART.LOGO_PATH)) != OK:
		push_error("Unable to read the Sunny Scout startup artwork")
		return
	var backdrop_file := write_art(destination,"scout-backdrop-",backdrop.save_jpg_to_buffer(0.92),"jpg")
	var logo_file := write_art(destination,"scout-logo-",logo.get_region(STARTUP_ART.LOGO_REGION).save_png_to_buffer(),"png")
	if backdrop_file.is_empty() or logo_file.is_empty(): return
	# Do not use the platform's generic index.png: old server/browser caches or
	# another editor version can supply its default engine splash at that URL.
	var html := FileAccess.get_file_as_string(html_file)
	if not html.contains("__SCOUT_BACKDROP__") or not html.contains("__SCOUT_LOGO__"):
		push_error("The Web loading shell is missing its Sunny Scout artwork placeholders")
		return
	html = html.replace("__SCOUT_BACKDROP__",backdrop_file).replace("__SCOUT_LOGO__",logo_file)
	var file := FileAccess.open(html_file,FileAccess.WRITE)
	if file == null:
		push_error("Unable to write the Sunny Scout loading page")
		return
	file.store_string(html)
	file.close()
	# Only remove older files generated by this exporter, keeping the output
	# bounded when the artwork changes. Content hashes make new URLs reliable.
	for old in DirAccess.get_files_at(destination):
		var ours := (old.begins_with("scout-backdrop-") and old.ends_with(".jpg")) or (old.begins_with("scout-logo-") and old.ends_with(".png"))
		if ours and old != backdrop_file and old != logo_file:
			DirAccess.remove_absolute(destination.path_join(old))

func write_art(destination: String, prefix: String, bytes: PackedByteArray, extension: String) -> String:
	var hash := HashingContext.new()
	hash.start(HashingContext.HASH_SHA256)
	hash.update(bytes)
	var name := prefix + hash.finish().hex_encode().substr(0,12) + "." + extension
	var file := FileAccess.open(destination.path_join(name),FileAccess.WRITE)
	if file == null or bytes.is_empty():
		push_error("Unable to export Sunny Scout artwork: "+name)
		return ""
	file.store_buffer(bytes)
	return name
